# Copy to .env and add your Google AI Studio API key. NEVER commit .env
GOOGLE_API_KEY=
# Defaults to Gemma 4 31B.
# GOOGLE_MODEL=gemma-4-31b-it
# GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Retrieval score below this means "not in your material" (0 to 1)
MIN_SCORE=0.08
# Share of the question's keywords that must appear in your notes (0 to 1)
MIN_COVERAGE=0.4
